# Never place real production secrets in this file.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never expose these through NEXT_PUBLIC_* variables or browser code.
SUPABASE_SERVICE_ROLE_KEY=

KLAVIYO_CLIENT_ID=
KLAVIYO_CLIENT_SECRET=
KLAVIYO_REDIRECT_URI=
# Base64-encoded 32-byte key used only to encrypt Klaviyo OAuth tokens at rest.
KLAVIYO_TOKEN_ENCRYPTION_KEY=

SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_REDIRECT_URI=
# Base64-encoded 32-byte key used only to encrypt Shopify offline tokens at rest.
SHOPIFY_TOKEN_ENCRYPTION_KEY=

# Resend is used only for explicit single-recipient campaign test delivery.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO=

# Razorpay subscriptions. Public and server key IDs must refer to the same account.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID_STARTER=
RAZORPAY_PLAN_ID_PRO=
RAZORPAY_PLAN_ID_AGENCY=
# Keep false until Abu approves pricing, refund terms, and paid-launch activation.
BILLING_LAUNCH_ENABLED=false
