{
  "name": "pagevelope",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=20.9.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace @pagevelope/web run dev",
    "build": "npm run core:typecheck && npm run core:test && npm --workspace @pagevelope/web run build",
    "lint": "npm --workspace @pagevelope/web run lint",
    "typecheck": "npm run core:typecheck && npm --workspace @pagevelope/web run typecheck",
    "test": "npm run core:test",
    "core:typecheck": "tsc -p tsconfig.core.json --noEmit",
    "core:build": "rm -rf .build/core && tsc -p tsconfig.core.json",
    "core:test": "npm run core:build && node --test tests/core/*.test.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.12",
    "typescript": "^6.0.0",
    "vitest": "4.1.10"
  },
  "type": "module"
}
